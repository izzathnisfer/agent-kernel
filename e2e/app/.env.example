# Copy to .env (gitignored) and fill in. deploy/deploy.sh loads this file and exports
# each value as the matching TF_VAR_* for terraform. Values already exported as TF_VAR_*
# in your shell take precedence.

# OpenAI key for the deployed agent
OPENAI_API_KEY=sk-...

# Slack app credentials (from api.slack.com/apps -> your e2e app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Telegram bot credentials (from BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Optional but recommended; generate with: openssl rand -hex 16
# Must match E2E_TELEGRAM_WEBHOOK_SECRET when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
